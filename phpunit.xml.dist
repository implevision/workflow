<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Package">
            <directory>tests</directory>
            <exclude>tests/Consumer</exclude>
        </testsuite>
        <testsuite name="Taurus">
            <directory>tests/Consumer/Taurus</directory>
            <!-- TODO: stale since TbClaim moved to claimsQuery; fix expectations and remove. -->
            <exclude>tests/Consumer/Taurus/GraphQL/SchemaFieldAvailableToFetch/TbClaimSchemaFieldAvailableToFetchTest.php</exclude>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
